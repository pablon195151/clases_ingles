# Copia este archivo como .env y llena solo lo que quieras activar.
# Sin llaves, la app funciona igual con la voz y el reconocimiento del navegador
# y con el motor de conversación local.

PORT=8080

# IA conversacional (respuestas naturales y correcciones) — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Voz neuronal con sincronía de boca por amplitud — https://platform.openai.com
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
VOICE_FOX=ash
VOICE_OWL=sage
VOICE_MUSICIAN=coral
VOICE_NPC=alloy

# Evaluación de pronunciación por sonido — https://portal.azure.com → crear recurso "Speech"
# (el plan gratis F0 incluye horas de audio al mes). Copia la llave y la región (ej. eastus).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
